{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/cli.ts migrate dev",
    "db:migrate:test": "tsx src/db/cli.ts migrate test",
    "db:status": "tsx src/db/cli.ts status dev",
    "db:status:test": "tsx src/db/cli.ts status test",
    "test:unit": "vitest run --project unit",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "dev": "tsx watch src/index.ts"
  }
}
