# Образец файла окружения. Скопируйте в .env и задайте свои значения.
POSTGRES_DB=dormhub
POSTGRES_USER=dormhub_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://dormhub_user:change_me@127.0.0.1:5432/dormhub
DATABASE_URL_TEST=postgresql://dormhub_user:change_me@127.0.0.1:5432/dormhub_test

# Секрет подписи JWT: не менее 32 символов, например: openssl rand -hex 32
JWT_SECRET=change_me

SEED_DEMO_PASSWORD=

# Почта: в разработке письма ловит Mailpit (http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=DormHub <no-reply@dormhub.local>